APP_NAME="Restaurant Scan API"
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_TIMEZONE=Africa/Kinshasa
APP_URL=https://api.restaurascan.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_resto
DB_USERNAME=e_resto
DB_PASSWORD=CHANGE_ME

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=restaurascan.com,www.restaurascan.com,admin.restaurascan.com,api.restaurascan.com
CORS_ALLOWED_ORIGINS=https://restaurascan.com,https://www.restaurascan.com,https://admin.restaurascan.com

CLIENT_FRONTEND_URL=https://restaurascan.com
RESTAURANT_ADMIN_URL=https://admin.restaurascan.com
AUTH_TOKEN_TTL_MINUTES=1440

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=e-resto
REVERB_APP_KEY=e-resto-key
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=api.restaurascan.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@restaurascan.com
MAIL_FROM_NAME="Restaurant Scan"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAISHAPAY_BASE_URL=
MAISHAPAY_MERCHANT_ID=
MAISHAPAY_API_KEY=
MAISHAPAY_CALLBACK_URL=https://api.restaurascan.com/api/saas/payment-callback

L5_SWAGGER_GENERATE_ALWAYS=false
